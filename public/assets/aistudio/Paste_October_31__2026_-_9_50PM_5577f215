    if(has(t,'^(नहीं|नही|ना|मत|no|रुको|ठहरो|रहने दो)( |$)')){P=null;return 'ठीक है, रद्द कर दिया।'}
    return 'हाँ या नहीं बोलिए।';
  }};
  return msg+' हाँ या नहीं?';
}
function askPick(c,raw){
  P={h:(r2,t2)=>{
    const i=pickIndex(t2,c);
