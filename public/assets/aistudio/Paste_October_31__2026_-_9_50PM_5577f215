function historyView(){
  const now=new Date();
  const curM=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');
  if(!V.hMonth)V.hMonth=curM;
  const [yy,mm]=V.hMonth.split('-').map(Number);
  const months=[];
  for(let i=0;i<24;i++){
    const d=new Date(now.getFullYear(),now.getMonth()-i,1);
    months.push({v:d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'),l:d.toLocaleString('en-IN',{month:'long',year:'numeric'})});
  }
  if(!months.some(m=>m.v===V.hMonth)){months.push({v:V.hMonth,l:new Date(yy,mm-1,1).toLocaleString('en-IN',{month:'long',year:'numeric'})})}
  const all=DB.log.filter(l=>!l.deleted);
  const ms=all.filter(l=>{
    const d=new Date(l.t);
    return d.getFullYear()===yy&&(d.getMonth()+1)===mm;
  }).sort((a,b)=>b.t-a.t);
  const totAdd=ms.filter(l=>l.type==='add').reduce((s,l)=>s+l.amt,0);
  const totSub=ms.filter(l=>l.type==='sub').reduce((s,l)=>s+l.amt,0);
  const beforeMonth=new Date(yy,mm-1,1).getTime();
  const balBefore=all.filter(l=>l.t<beforeMonth).reduce((s,l)=>{
    if(l.type==='add')return s+l.amt;
    if(l.type==='sub')return s-l.amt;
    return s;
  },0);
  const balEnd=balBefore+totAdd-totSub;
  const f=V.hf;
  const filtered=ms.filter(x=>f==='all'||(f==='add'&&x.type==='add')||(f==='sub'&&x.type==='sub')||(f==='acc'&&['create','edit','delete','restore','purge','logdel'].includes(x.type)));
  const c=[['all','सब'],['add','उधार (+)'],['sub','जमा (−)'],['acc','खाते']];
  return topbar('सारा हिसाब-किताब')+'<div class="wrap">'
  +'<div class="month-box"><label>महीना चुनें</label><div class="month-bar"><select onchange="V.hMonth=this.value;render()">'+months.map(m=>'<option value="'+m.v+'" '+(m.v===V.hMonth?'selected':'')+'>'+m.l+(m.v===curM?' (इस महीने)':'')+'</option>').join('')+'</select></div>'
  +'<div class="nums"><div><span class="mut">उधार बढ़ा</span><b class="red">'+money(totAdd)+'</b></div><div><span class="mut">जमा हुआ</span><b class="grn">'+money(totSub)+'</b></div><div><span class="mut">महीने के अंत में बैलेंस</span><b>'+(balEnd<0?'−':'')+money(balEnd)+'</b></div></div></div>'
  +'<div class="chips">'+c.map(x=>'<button class="'+(f===x[0]?'on':'')+'" onclick="V.hf=\''+x[0]+'\';render()">'+x[1]+'</button>').join('')+'</div>'
  +(filtered.length?filtered.map(x=>logRow(x,true)).join(''):'<p class="mut" style="text-align:center">इस महीने कोई इतिहास नहीं</p>')+'</div>';
}

