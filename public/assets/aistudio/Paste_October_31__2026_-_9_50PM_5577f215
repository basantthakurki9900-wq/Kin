    return confirmAct('खत्म स्टॉक की पूरी सूची, '+DB.stock.length+' सामान, हटानी है?',()=>{DB.stock=[];save();render();return 'पूरी स्टॉक सूची साफ़ कर दी।'});
  }
  if(has(t,'(आ गया|आ गई|आ गए|आ गये|मिल गया|मिल गई|मंगा लिया|मंगवा लिया|आ चुका|आ चुकी|भर गया|आ गयी)')){
    const hits=DB.stock.filter(s=>t.includes(norm(s.name)));
    if(hits.length){const ids=hits.map(s=>s.id);DB.stock=DB.stock.filter(s=>!ids.includes(s.id));save();render();return hits.map(s=>s.name).join(' और ')+' स्टॉक सूची से हटा दिया।'}
    if(hasS)return 'यह सामान खत्म सूची में नहीं मिला।';
    return null;
  }
  if(hasS&&has(t,'(व्हाट्सएप|whatsapp|भेज|शेयर)')){
    if(!DB.stock.length)return 'सूची खाली है, भेजने को कुछ नहीं।';
    shareStock();return 'खत्म स्टॉक की सूची व्हाट्सएप पर भेजने के लिए खोल दी।';
  }
  if((hasS&&has(t,'(बता|पढ़|सुना|क्या|कौन|कितने|सूची|लिस्ट)'))||has(t,'(क्या क्या खत्म|कौन सा सामान खत्म|क्या खत्म|कितना सामान खत्म)')){
    if(!DB.stock.length)return 'कोई सामान खत्म नहीं है।';
    return 'खत्म सामान: '+DB.stock.map(s=>s.name+(s.note?' '+s.note:'')).join(', ')+'।';
  }
  if(t.includes('खत्म')||(hasS&&has(t,'(जोड़|चढ़ा|चढा|लिख|ऐड|add)'))){
    const SW=new Set(['खत्म','हो','गया','गई','गए','गये','गयी','है','हैं','स्टॉक','में','जोड़ो','जोड','चढाओ','चढा','लिखो','लिख','करो','कर','सामान','लिस्ट','सूची','का','की','के','अब','नया','नई','भी','ऐड','add','कृपया','प्लीज','please','सब','पूरा','मेरा','मेरी'].map(nz));
    const tk=t.split(' ');const groups=[{n:[],q:[]}];
    tk.forEach((w,i)=>{
      if(w==='और'){groups.push({n:[],q:[]});return}
      if(w==='दो'&&(i===tk.length-1||['जोड','लिख','चढा','कर','जोड़'].includes(tk[i-1])))return;
      if(SW.has(w))return;
      const g=groups[groups.length-1];
      if(isNumTok(w)||QU.includes(w))g.q.push(w);else g.n.push(w);
    });
    const items=groups.filter(g=>g.n.length);
    if(!items.length)return ask('कौन सा सामान खत्म हुआ? नाम बोलिए।',(r2,t2)=>{
      const nm=t2.trim();if(!nm)return 'सामान का नाम बोलिए।';P=null;DB.stock.unshift({id:uid(),name:nm,note:'',t:Date.now()});save();render();return nm+' खत्म स्टॉक में जोड़ दिया।';
    });
    items.forEach(g=>DB.stock.unshift({id:uid(),name:g.n.join(' '),note:g.q.join(' '),t:Date.now()}));
    save();render();
    return items.map(g=>g.n.join(' ')+(g.q.length?' ('+g.q.join(' ')+')':'')).join(' और ')+' खत्म स्टॉक में जोड़ दिया।';
  }
  return null;
}
