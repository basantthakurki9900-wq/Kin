}
function stockCmd(t,raw){
  const hasS=t.includes('स्टॉक');
  if(hasS&&has(t,'(खोल|दिखा|जाओ|चलो|टैब)')&&!has(t,'(बता|पढ़|सुना)')){go('stock');return 'खत्म स्टॉक खोल दिया। '+(DB.stock.length?DB.stock.length+' सामान खत्म हैं।':'कोई सामान खत्म नहीं है।')}
  if(hasS&&has(t,'(हटा|साफ|खाली|मिटा|डिलीट)')&&has(t,'(सारा|सब|पूरा|पूरी|सारी|सभी)')){
