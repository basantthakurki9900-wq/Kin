function findRuns(tk){
  const runs=[];let i=0;
  while(i<tk.length){
    if(isNumTok(tk[i])||isMulTok(tk[i])){
      let j=i,tot=0,cur=0;
      while(j<tk.length&&(isNumTok(tk[j])||isMulTok(tk[j]))){
        const x=tk[j];
        if(isMulTok(x)){if(x==='सौ')cur=(cur||1)*100;else{tot+=(cur||1)*MULW[x];cur=0}}
        else cur+=numVal(x);
        j++;
      }
      runs.push({s:i,e:j,v:tot+cur});i=j;
    }else i++;
  }
  return runs;
}
