  if(d.length>=3){const i=c.findIndex(a=>a.mobile.endsWith(d));if(i>=0)return i}
  for(const w of tk){if(ORDM[w]!==undefined&&ORDM[w]<c.length)return ORDM[w]}
  const m=c.filter(a=>t.includes(norm(a.name)));
  if(m.length===1)return c.indexOf(m[0]);
  return -1;
}
const ORDN=['पहला','दूसरा','तीसरा','चौथा','पांचवां'];

/* ---- बातचीत की स्थिति ---- */
let P=null;           // अधूरा सवाल: {h:(raw,t)=>जवाब}
let closeLater=false;
function ask(msg,h){P={h};return msg}
function confirmAct(msg,fn){
  P={h:(raw,t)=>{
