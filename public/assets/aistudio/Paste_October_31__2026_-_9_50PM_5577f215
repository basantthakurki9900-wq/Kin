function applyTxn(a,sign,amt,x,force){
  if(sign<0&&!force&&DB.settings.depositLimit>0){
    const nb=a.bal-amt;
    if(nb<0&&Math.abs(nb)>DB.settings.depositLimit)
      return confirmAct('जमा लिमिट '+sp(DB.settings.depositLimit)+' है और इससे ज़्यादा एडवांस हो जाएगा। फिर भी जमा करूँ?',()=>applyTxn(a,sign,amt,x,true));
  }
  if(force){
    const before=a.bal;a.bal=Math.round((a.bal-amt)*100)/100;
    log('sub',a,amt,before,a.bal,x.note,'लिमिट-ओवर',x.items,0);save();
  }else{
    const r=txn(a.id,sign*amt,x.note,'आवाज़',x.items,sign>0?x.due:0);
    if(r&&r.error)return 'जमा लिमिट '+sp(r.limit)+' है।';
  }
  render();
  let m=a.name+' के खाते में '+sp(amt)+(sign<0?' घटा दिए गए।':' जोड़ दिए गए।');
  if(x.items&&sign>0)m+=' सामान: '+x.items+'।';
  if(x.due&&sign>0)m+=' वापसी तारीख '+dt(x.due).split(',')[0]+' रखी।';
  m+=' अब '+balText(a)+'।';
  if(sign>0&&a.limit>0&&a.bal>a.limit)m+=' ध्यान दें, उधार सीमा '+sp(a.limit)+' पार हो गई है।';
  return m;
}
function doTxnVoice(a,t){
  const x=extractTxn(t);
  if(!(x.amt>0))return 'रकम समझ नहीं आई। फिर से बोलिए।';
  const dir=direction(t);
  if(dir===0){
    return ask(sp(x.amt)+' उधार चढ़ाऊँ या जमा करूँ? उधार या जमा बोलिए।',(r2,t2)=>{
