function parseMonth(t,tk){
  const now=new Date();
  if(has(t,'(पिछले महीने|पिछला महीना|बीते महीने|last month)')){const d=new Date(now.getFullYear(),now.getMonth()-1,1);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')}
  if(has(t,'(इस महीने|इस माह|चालू महीने)'))return now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');
  for(let i=0;i<tk.length;i++){
    if(MONN[tk[i]]){
      let y=now.getFullYear();const m=MONN[tk[i]];
      const yr=tk.find(w=>/^20\d\d$/.test(w));
      if(yr)y=+yr;else if(m>now.getMonth()+1)y--;
      return y+'-'+String(m).padStart(2,'0');
    }
  }
  return null;
}
function monthText(v){
