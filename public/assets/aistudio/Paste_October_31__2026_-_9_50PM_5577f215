function saveAmt(id,sign){
  const v=parseFloat($('#am').value);
  if(!(v>0)){toast('सही रकम डालिए');return}
  const note=$('#an').value.trim();
  const items=$('#ai')?$('#ai').value.trim():'';
  const dueStr=$('#ad')?$('#ad').value:'';
  const due=dueStr?new Date(dueStr).getTime():0;
  if(sign<0&&DB.settings.depositLimit>0){
    const a=get(id);
    const newBal=a.bal-v;
    if(newBal<0&&Math.abs(newBal)>DB.settings.depositLimit){
      _forceSaveData={id,v,note,items,due};
      modal('<h3>⚠ जमा लिमिट ओवर!</h3><div class="warn-pop">इस खाते में ज़्यादा से ज़्यादा <b>'+money(DB.settings.depositLimit)+'</b> तक जमा हो सकता है।</div><div class="row"><button class="btn red" onclick="forceSaveAmt()">हाँ, ज़रूरी है</button><button class="btn2" onclick="closeModal()">नहीं</button></div>');
      return;
    }
  }
  const r=txn(id,sign*v,note,'',items,due);
  if(r&&r.error==='deposit'){
    _forceSaveData={id,v,note,items,due};
    modal('<h3>⚠ जमा लिमिट ओवर!</h3><div class="warn-pop">जमा लिमिट <b>'+money(r.limit)+'</b> है।</div><div class="row"><button class="btn red" onclick="forceSaveAmt()">फिर भी जमा करें</button><button class="btn2" onclick="closeModal()">नहीं</button></div>');
    return;
  }
  closeModal();render();toast('हो गया');
}
function forceSaveAmt(){
