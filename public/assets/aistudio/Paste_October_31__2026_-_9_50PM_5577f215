<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#0b7a5c">
<title>खाता बुक</title>
<style>
:root{--g:#0b7a5c;--gd:#075c45;--r:#d9362b;--bg:#f2f6f4;--card:#fff;--t:#1b2420;--m:#6b7a73;--b:#e1e8e4;--warn:#ff9800;--warn-bg:#fff8e1;--danger-bg:#fdeceb}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--t);font-family:system-ui,-apple-system,"Noto Sans Devanagari",sans-serif;font-size:16px;padding-bottom:140px}
body.vp{padding-top:230px}
.top{background:var(--g);color:#fff;padding:16px;position:sticky;top:0;z-index:5}
.top h1{margin:0;font-size:20px}.top small{opacity:.85}
.wrap{padding:12px;max-width:720px;margin:auto}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.stat{background:var(--card);border-radius:14px;padding:12px;border:1px solid var(--b)}
.stat b{display:block;font-size:20px;margin-top:2px}
.red{color:var(--r)}.grn{color:var(--g)}.mut{color:var(--m)}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--b);border-radius:10px;font-size:16px;background:#fff;margin:4px 0 8px;font-family:inherit}
label{display:block;font-size:13px;color:var(--m);margin-top:6px}
.row{display:flex;gap:8px;align-items:center}
.btn{background:var(--g);color:#fff;border:0;border-radius:10px;padding:12px 16px;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer}
.btn.red{background:var(--r);color:#fff}
.btn2{background:#e6efeb;color:var(--gd);border:0;border-radius:10px;padding:11px 14px;font-size:14px;font-weight:600;font-family:inherit;cursor:pointer}
.btn2.d{background:#fdeceb;color:var(--r)}
.item{background:var(--card);border:1px solid var(--b);border-radius:14px;padding:12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.item.ovr{border-left:4px solid var(--r);background:var(--danger-bg)}
.item .n{font-weight:700}.item .s{font-size:13px;color:var(--m)}
.amt{text-align:right;font-weight:800;font-size:17px}.amt small{display:block;font-weight:500;font-size:12px}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--b);display:flex;z-index:6}
nav button{flex:1;border:0;background:none;padding:8px 2px 10px;font-size:11px;color:var(--m);font-family:inherit;cursor:pointer}
nav button span{display:block;font-size:20px}
nav button.on{color:var(--g);font-weight:700}
.mic{position:fixed;right:16px;bottom:78px;width:60px;height:60px;border-radius:50%;border:0;background:var(--r);color:#fff;font-size:26px;box-shadow:0 4px 14px rgba(0,0,0,.3);z-index:7;cursor:pointer}
.mic.rec{animation:pulse 1.2s infinite}
body.vp .mic{display:none}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
.fab{position:fixed;left:16px;bottom:78px;background:var(--g);color:#fff;border:0;border-radius:30px;padding:16px 20px;font-size:16px;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:7;font-family:inherit;cursor:pointer}
.fab2{position:fixed;left:50%;transform:translateX(-50%);bottom:78px;background:#1b2420;color:#fff;border:0;border-radius:30px;padding:14px 22px;font-size:14px;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:7;font-family:inherit;cursor:pointer}
#modal{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:flex-end;justify-content:center;z-index:20}
#modal.on{display:flex}
.sheet{background:#fff;width:100%;max-width:720px;border-radius:20px 20px 0 0;padding:18px;max-height:90vh;overflow:auto}
body.vp .sheet{max-height:calc(100vh - 250px)}
.sheet h3{margin:0 0 8px}
.big{background:var(--card);border-radius:16px;padding:16px;text-align:center;border:1px solid var(--b);margin-bottom:10px}
.big b{font-size:34px;display:block}
.acts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.acts .btn,.acts .btn2{width:100%}
.log{background:var(--card);border:1px solid var(--b);border-radius:12px;padding:10px;margin-bottom:8px;font-size:14px;position:relative}
.log .h{display:flex;justify-content:space-between;font-weight:700;align-items:flex-start;gap:8px}
.log .del{background:none;border:0;color:var(--r);font-size:16px;cursor:pointer;padding:2px 6px;border-radius:6px;flex-shrink:0}
.log .del:hover{background:var(--danger-bg)}
.log .items{background:#fff8e1;border-left:3px solid var(--warn);padding:4px 8px;border-radius:6px;margin-top:4px;font-size:13px}
.log .due{background:#fdeceb;color:var(--r);padding:2px 8px;border-radius:6px;font-size:12px;display:inline-block;margin-top:4px}
.log .due.ok{background:#e6f5ee;color:var(--g)}
.badge{background:#fff3cd;color:#8a6d00;border-radius:6px;padding:1px 6px;font-size:11px;margin-left:4px}
.chips{display:flex;gap:6px;overflow:auto;margin-bottom:10px;flex-wrap:wrap}
.chips button{border:1px solid var(--b);background:#fff;border-radius:20px;padding:7px 14px;white-space:nowrap;font-family:inherit;cursor:pointer}
.chips button.on{background:var(--g);color:#fff;border-color:var(--g)}
#qr{display:flex;justify-content:center;margin:12px 0}
.tr{background:#f2f6f4;border-radius:10px;padding:10px;min-height:44px;margin:8px 0;font-size:14px}
.res{background:#e6f5ee;border-radius:10px;padding:10px;min-height:44px;margin:8px 0;font-weight:600;font-size:15px}
.hint{font-size:13px;color:var(--m);line-height:1.6}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:150px;background:#222;color:#fff;padding:10px 16px;border-radius:20px;font-size:14px;z-index:30;display:none;max-width:90%}
.center{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:24px;max-width:420px;margin:auto;text-align:center}
.back{background:none;border:0;color:#fff;font-size:15px;padding:0;margin-bottom:6px;font-family:inherit;cursor:pointer}
.month-bar{display:flex;gap:6px;align-items:center;margin-bottom:10px}
.month-bar select{margin:0;width:auto;flex:1}
.month-box{background:var(--card);border:1px solid var(--b);border-radius:12px;padding:12px;margin-bottom:10px}
.month-box .nums{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center;margin-top:6px}
.month-box .nums b{display:block;font-size:18px}
.warn-pop{background:var(--warn-bg);border:2px solid var(--warn);border-radius:12px;padding:12px;margin:8px 0}
.lim-box{background:#e6f5ee;border:1px solid var(--g);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--gd);margin-top:4px}
.lim-box.over{background:var(--danger-bg);border-color:var(--r);color:var(--r)}
/* आवाज़ सहायक पैनल (ऊपर, ताकि नीचे का ऐप और पॉप-अप चलते रहें) */
#vpanel{position:fixed;top:0;left:0;right:0;z-index:25;background:#fff;border-bottom:3px solid var(--g);box-shadow:0 6px 20px rgba(0,0,0,.2);padding:8px 12px 10px;display:none;max-width:720px;margin:auto;border-radius:0 0 16px 16px;max-height:75vh;overflow:auto}
#vpanel.on{display:block}
#vpanel .vh{display:flex;justify-content:space-between;align-items:center;gap:8px}
#vpanel .tr,#vpanel .res{min-height:32px;margin:4px 0;padding:6px 10px;font-size:14px}
#vpanel input{margin:4px 0}
#vpanel .btn,#vpanel .btn2{padding:9px 12px}
</style>
</head>
<body>
<div id="app"></div>
<div id="modal"></div>
<div id="vpanel"></div>
<div id="toast"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
const KEY='khatabook_v2';
let DB;
try{DB=JSON.parse(localStorage.getItem(KEY)||'null')}catch(e){DB=null}
if(DB){
  if(!DB.settings.depositLimit)DB.settings.depositLimit=1000;
  if(DB.settings.defaultCreditLimit===undefined)DB.settings.defaultCreditLimit=0;
  if(!DB.log)DB.log=[];
  DB.log.forEach(l=>{if(l.deleted===undefined)l.deleted=false});
  DB.accounts.forEach(a=>{if(a.limit===undefined)a.limit=0});
}else{
  DB={accounts:[],log:[],stock:[],settings:{shop:'मेरी दुकान',upi:'',link:'',pin:'',depositLimit:1000,defaultCreditLimit:0}};
}
if(!DB.accounts.length && !DB.log.length){
  try{
    const old=JSON.parse(localStorage.getItem('khatabook_v1')||'null');
    if(old&&old.accounts){
      DB.accounts=old.accounts;
      DB.log=old.log||[];
      DB.stock=old.stock||[];
      DB.settings=Object.assign(DB.settings,old.settings);
      DB.log.forEach(l=>{if(l.deleted===undefined)l.deleted=false});
      DB.accounts.forEach(a=>{if(a.limit===undefined)a.limit=0});
    }
  }catch(e){}
}
const save=()=>localStorage.setItem(KEY,JSON.stringify(DB));
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=n=>'₹'+Math.abs(n).toLocaleString('en-IN');
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const dt=t=>new Date(t).toLocaleString('en-IN',{day:'numeric',month:'short',year:'numeric',hour:'numeric',minute:'2-digit'});
const get=id=>DB.accounts.find(a=>a.id===id);
const h10=m=>String(m).replace(/\D/g,'').slice(-10);
const hsh=s=>{let x=5381;for(const c of s)x=((x*33)^c.charCodeAt(0))>>>0;return x.toString(36)};
let V={tab:'home',open:null,q:'',hf:'all',hMonth:''};
let _forceSaveData=null;

function toast(m){const t=$('#toast');t.textContent=m;t.style.display='block';clearTimeout(toast.id);toast.id=setTimeout(()=>t.style.display='none',2600)}
function modal(h){const m=$('#modal');m.innerHTML='<div class="sheet">'+h+'</div>';m.classList.add('on');m.onclick=e=>{if(e.target===m)closeModal()}}
function closeModal(){_forceSaveData=null;const m=$('#modal');m.classList.remove('on');m.innerHTML=''}

const LBL={create:'खाता बना',add:'उधार चढ़ाया (+)',sub:'पैसे घटाए / जमा (−)',edit:'खाता बदला',delete:'खाता हटाया गया',restore:'खाता वापस लाया गया',purge:'हमेशा के लिए हटाया',logdel:'इतिहास एंट्री हटाई'};
function log(type,a,amt,before,after,note,src,items,due){DB.log.push({id:uid(),t:Date.now(),type,acc:a.id,name:a.name,mobile:a.mobile,amt:amt||0,before,after,note:note||'',src:src||'',items:items||'',due:due||0,deleted:false})}
function createAccount(name,mobile,src,limit){
  name=name.trim();mobile=h10(mobile);
  if(!name)return 'नाम डालिए';
  if(mobile.length<10)return 'मोबाइल नंबर 10 अंक का होना चाहिए';
  if(DB.accounts.some(a=>!a.deleted&&h10(a.mobile)===mobile))return 'इस नंबर का खाता पहले से है';
  const a={id:uid(),name,mobile,bal:0,created:Date.now(),deleted:false,limit:limit||0};
  DB.accounts.push(a);log('create',a,0,0,0,'',src);save();return a;
}
function txn(id,delta,note,src,items,due){
  const a=get(id);const before=a.bal;
  const newBal=Math.round((a.bal+delta)*100)/100;
  if(delta<0 && DB.settings.depositLimit>0){
    const newAdv=newBal<0?Math.abs(newBal):0;
    if(newAdv>DB.settings.depositLimit){
      return {error:'deposit',newAdv,limit:DB.settings.depositLimit};
    }
  }
  a.bal=newBal;
  log(delta>0?'add':'sub',a,Math.abs(delta),before,a.bal,note,src,items,due);save();
  return {ok:true};
}
function delAcc(id){const a=get(id);a.deleted=true;a.deletedAt=Date.now();log('delete',a,0,a.bal,a.bal);save();V.open=null;closeModal();render();toast('खाता हटा दिया')}
function restoreAcc(id){const a=get(id);a.deleted=false;delete a.deletedAt;log('restore',a,0,a.bal,a.bal);save();render();toast('खाता वापस आ गया')}
function purgeAcc(id){const a=get(id);log('purge',a,0,a.bal,a.bal);DB.accounts=DB.accounts.filter(x=>x.id!==id);save();closeModal();render()}

function delLogEntry(logId){
  const l=DB.log.find(x=>x.id===logId);
  if(!l)return;
  modal('<h3>इस एंट्री को हटाएँ?</h3><p class="mut">खाते का बैलेंस बिल्कुल वैसे ही रहेगा, सिर्फ़ इतिहास से यह एंट्री हटेगी।</p>'+logRow(l,false,false)+'<div class="row"><button class="btn red" onclick="confirmDelLog(\''+logId+'\')">हाँ, हटाओ</button><button class="btn2" onclick="closeModal()">नहीं</button></div>');
}
function confirmDelLog(logId){
  const l=DB.log.find(x=>x.id===logId);
  if(!l)return;
  l.deleted=true;l.deletedAt=Date.now();
  const a=get(l.acc);if(a)log('logdel',a,0,a.bal,a.bal,'हटाई गई एंट्री: '+LBL[l.type]+(l.amt?' '+money(l.amt):''));
  save();closeModal();render();toast('एंट्री हटा दी');
}
function clearHistory(accId){
  const a=get(accId);
  modal('<h3>'+esc(a.name)+' की पूरी हिस्ट्री साफ़ करें?</h3><p class="mut">खाते का बैलेंस बिल्कुल वैसे ही रहेगा, सिर्फ़ इतिहास की सारी एंट्री हटेंगी।</p><div class="row"><button class="btn red" onclick="confirmClearHistory(\''+accId+'\')">हाँ, पूरी साफ़ करो</button><button class="btn2" onclick="closeModal()">नहीं</button></div>');
}
function confirmClearHistory(accId){
  const cnt=DB.log.filter(l=>l.acc===accId&&!l.deleted).length;
  DB.log.forEach(l=>{if(l.acc===accId&&!l.deleted){l.deleted=true;l.deletedAt=Date.now()}});
  const a=get(accId);if(a)log('logdel',a,0,a.bal,a.bal,cnt+' एंट्री साफ़ की गई');
  save();closeModal();render();toast('पूरी हिस्ट्री साफ़ हो गई');
}

function lockView(){return '<div class="center"><h1>🔒 खाता बुक</h1><p class="mut">PIN डालिए</p><input id="pin" type="password" inputmode="numeric" placeholder="PIN" onkeydown="if(event.key===\'Enter\')unlock()"><button class="btn" onclick="unlock()">खोलें</button></div>'}
function unlock(){if($('#pin').value===DB.settings.pin){sessionStorage.setItem('kb_ok','1');render()}else toast('गलत PIN')}

function topbar(sub){return '<div class="top"><h1>📒 '+esc(DB.settings.shop)+'</h1><small>'+sub+'</small></div>'}
function nav(){
  const t=[['home','👥','खाते'],['stock','📦','खत्म स्टॉक'],['deleted','🗑️','हटाए गए'],['history','🕘','इतिहास'],['settings','⚙️','सेटिंग']];
  return '<nav>'+t.map(x=>'<button class="'+(V.tab===x[0]?'on':'')+'" onclick="go(\''+x[0]+'\')"><span>'+x[1]+'</span>'+x[2]+'</button>').join('')+'</nav>';
}
function go(t){closeModal();V.tab=t;V.open=null;render();window.scrollTo(0,0)}
function openAcc(id){V.open=id;render();window.scrollTo(0,0)}

function isOverdue(a){
  if(a.bal<=0)return false;
  const now=Date.now();
  return DB.log.some(l=>l.acc===a.id&&!l.deleted&&l.due&&l.due<now&&l.type==='add');
}
function nextDue(a){
  const now=Date.now();
  const ds=DB.log.filter(l=>l.acc===a.id&&!l.deleted&&l.due&&l.type==='add').map(l=>l.due);
  if(!ds.length)return 0;
  const future=ds.filter(d=>d>now);
  return future.length?Math.min(...future):Math.max(...ds);
}
function balHtml(a){
  let extra='';
  if(isOverdue(a)){extra='<div class="due" style="margin-top:4px">⏰ वापसी तारीख बीत गई</div>'}
  else if(a.bal>0){const d=nextDue(a);if(d){extra='<div class="due ok" style="margin-top:4px">📅 वापसी: '+dt(d).split(',')[0]+'</div>'}}
  if(a.bal>0)return '<div class="amt red">'+money(a.bal)+'<small>उधार बाकी</small></div>'+extra;
  if(a.bal<0)return '<div class="amt grn">'+money(a.bal)+'<small>एडवांस / आपको देना</small></div>';
  return '<div class="amt mut">₹0<small>हिसाब बराबर</small></div>';
}
function listHtml(){
  const q=V.q.trim().toLowerCase();
  const l=DB.accounts.filter(a=>!a.deleted&&(!q||a.name.toLowerCase().includes(q)||a.mobile.includes(q))).sort((a,b)=>{
    const ao=isOverdue(a)?1:0,bo=isOverdue(b)?1:0;
    if(ao!==bo)return bo-ao;
    return b.bal-a.bal;
  });
  if(!l.length)return '<p class="mut" style="text-align:center;margin-top:30px">'+(q?'कोई खाता नहीं मिला':'अभी कोई खाता नहीं। नीचे "+ नया खाता" दबाइए।')+'</p>';
  return l.map(a=>'<div class="item '+(isOverdue(a)?'ovr':'')+'" onclick="openAcc(\''+a.id+'\')"><div><div class="n">'+esc(a.name)+(isOverdue(a)?' <span style="color:var(--r)">⏰</span>':'')+'</div><div class="s">📱 '+esc(a.mobile)+'</div>'+(a.limit>0&&a.bal>a.limit?'<div class="lim-box over">⚠ उधार सीमा पार (सीमा: '+money(a.limit)+')</div>':'')+'</div>'+balHtml(a)+'</div>').join('');
}
function renderList(){const el=$('#list');if(el)el.innerHTML=listHtml()}
function homeView(){
  const act=DB.accounts.filter(a=>!a.deleted);
  const owe=act.reduce((s,a)=>s+Math.max(a.bal,0),0),adv=act.reduce((s,a)=>s+Math.max(-a.bal,0),0);
  const ovr=act.filter(isOverdue).length;
  return topbar(act.length+' खाते')+'<div class="wrap"><div class="cards"><div class="stat">कुल उधार बाकी<b class="red">'+money(owe)+'</b></div><div class="stat">एडवांस जमा<b class="grn">'+money(adv)+'</b></div></div>'
   +(ovr?'<div class="warn-pop">⏰ <b>'+ovr+' खाते</b> में वापसी तारीख बीत गई है। <button class="btn2" style="display:inline;margin:0 0 0 8px" onclick="bulkRemind()">याद दिलाएँ</button></div>':'')
   +'<input id="srch" placeholder="🔍 नाम या मोबाइल से खोजें" value="'+esc(V.q)+'" oninput="V.q=this.value;renderList()"><div id="list">'+listHtml()+'</div></div>'
   +'<button class="fab" onclick="newAccModal()">+ नया खाता</button>'
   +(owe>0?'<button class="fab2" onclick="bulkRemind()">💬 सबको याद दिलाएँ</button>':'');
}
function accView(a){
  const hs=DB.log.filter(l=>l.acc===a.id&&!l.deleted).sort((x,y)=>y.t-x.t);
  let limInfo='';
  if(a.limit>0){
    const over=a.bal>a.limit;
    limInfo='<div class="lim-box '+(over?'over':'')+'">उधार सीमा: '+money(a.limit)+(over?' (पार!)':' · बचा: '+money(Math.max(0,a.limit-a.bal)))+'</div>';
  }
  return '<div class="top"><button class="back" onclick="V.open=null;render()">← वापस</button><h1>'+esc(a.name)+'</h1><small>📱 '+esc(a.mobile)+'</small></div><div class="wrap">'
  +'<div class="big"><span class="mut">'+(a.bal>0?'उधार बाकी':a.bal<0?'एडवांस / आपको देना':'हिसाब बराबर')+'</span><b class="'+(a.bal>0?'red':a.bal<0?'grn':'mut')+'">'+money(a.bal)+'</b></div>'
  +limInfo
  +'<div class="acts"><button class="btn red" onclick="amtModal(\''+a.id+'\',1)">➕ उधार चढ़ाओ</button><button class="btn" onclick="amtModal(\''+a.id+'\',-1)">➖ पैसे घटाओ / जमा</button>'
  +'<button class="btn2" onclick="shareWA(\''+a.id+'\')">💬 WhatsApp पर भेजें</button><button class="btn2" onclick="showQR(\''+a.id+'\',\'chk\')">▦ QR कोड</button>'
