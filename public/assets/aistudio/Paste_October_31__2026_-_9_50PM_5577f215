    P=null;return runCommand(raw,c[i]);
  }};
  return 'इस नाम के '+c.length+' खाते हैं। '+c.map((a,i)=>(ORDN[i]||String(i+1))+': '+a.name+', मोबाइल के आखिरी चार अंक '+digitsSp(a.mobile.slice(-4))).join('। ')+'। किस खाते पर करना है?';
}

