/* ================== मुख्य कमांड ================== */
function runCommand(raw,forced){
  const t=norm(raw);if(!t)return '';
  if(P){
    if(has(t,'^(रद्द|कैंसल|cancel|छोड़ो|रहने दो|बस रहने दो)( |$)')){P=null;return 'ठीक है, रद्द कर दिया।'}
    return P.h(raw,t);
  }
  const tk=t.split(' ');
  if(has(t,'^(असिस्टेंट बंद|बंद करो|बंद कर दो|बस करो|धन्यवाद|थैंक यू|थैंक्स|अलविदा)( |$)')||has(t,'^(बस|बाय)$')){closeLater=true;return 'ठीक है, असिस्टेंट बंद कर रहा हूँ। धन्यवाद!'}
  if(has(t,'(मदद|हेल्प|help|क्या क्या कर सकते|क्या कर सकते|कमांड सूची)'))return helpSpeech();

  /* हटाए गए खाते: वापस लाना / हमेशा के लिए हटाना */
  if(has(t,'(वापस ला|रिस्टोर|बहाल|हमेशा के लिए|पूरा हटा|पूरी तरह हटा|परमानेंट|permanent)')){
    const isPurge=has(t,'(हमेशा के लिए|पूरा हटा|पूरी तरह हटा|परमानेंट|permanent)');
    const c=forced&&forced.deleted?[forced]:matchAccs(t,DB.accounts.filter(a=>a.deleted));
    if(!c.length)return 'हटाए गए खातों में यह नाम नहीं मिला।';
    if(c.length>1)return askPick(c,raw);
    const a=c[0];
    if(isPurge)return confirmAct(a.name+' का खाता हमेशा के लिए हटाना है?',()=>{purgeAcc(a.id);return a.name+' का खाता हमेशा के लिए हटा दिया।'});
    restoreAcc(a.id);return a.name+' का खाता वापस आ गया।';
  }

  /* नया खाता */
  if(has(t,'((नया|नए|नई) (खाता|ग्राहक|अकाउंट)|खाता बना|अकाउंट बना|ग्राहक जोड़|खाता जोड़)')){
    const pg=phoneGroup(tk);
    let nameT=tk.filter((w,i)=>!(pg&&i>=pg.s&&i<pg.e)).join(' ').replace(rx('(नया|नए|नई|खाता|ग्राहक|अकाउंट|बनाओ|बनाना|बना|दो|जोड़ो|जोड़|नाम|का|की|मोबाइल|नंबर|है|से|के लिए|एक|और|कृपया)','g'),' ').replace(/\s+/g,' ').trim();
    return newAccFlow({name:nameT,mobile:pg?pg.num:''});
  }

  /* खाता पहचान */
  let named=forced&&!forced.deleted?forced:null,amb=null;
  if(!named){
    const act=DB.accounts.filter(a=>!a.deleted);
    const pg=phoneGroup(tk);
    const byPh=pg?act.find(a=>h10(a.mobile)===pg.num):null;
    if(byPh)named=byPh;
    else{const m=matchAccs(t,act);if(m.length===1)named=m[0];else if(m.length>1)amb=m}
  }
  const openAccObj=V.open?get(V.open):null;
  const ctx=named||(openAccObj&&!openAccObj.deleted?openAccObj:null);

  /* स्टॉक */
  if((t.includes('स्टॉक')||t.includes('खत्म')||has(t,'(आ गया|आ गई|आ गए|आ गये|मिल गया|मंगा लिया|मंगवा लिया|आ चुका)'))&&(!named||t.includes('स्टॉक'))){
    const r=stockCmd(t,raw);if(r!==null)return r;
  }

  /* सेटिंग */
  if(has(t,'(दुकान|शॉप|shop) (का|की) नाम|दुकान नाम')){
    const nm=afterKey(raw,/(?:दुकान|शॉप|shop)\s*(?:का|की)?\s*नाम/i);
    const setN=n=>{DB.settings.shop=n;save();render();return 'दुकान का नाम '+n+' कर दिया।'};
    if(nm)return setN(nm);
    return ask('दुकान का नया नाम बोलिए।',(r2)=>{const n=r2.trim();if(!n)return 'नाम बोलिए।';P=null;return setN(n)});
  }
  if(has(t,'(यूपीआई|upi|यू पी आई)')&&!has(t,'(क्यूआर|qr)')&&has(t,'(आईडी|id|आई डी|सेट|बदल|रख|अपडेट|हटा|खाली)')){
    if(has(t,'(हटा|खाली)')){DB.settings.upi='';save();render();return 'UPI ID हटा दी।'}
    let s=afterKey(raw,/(?:यूपीआई|यू\s*पी\s*आई|upi)\s*(?:आईडी|आई\s*डी|id)?/i).toLowerCase();
    s=s.replace(/\s*(एट\s*द\s*रेट|at\s*the\s*rate|एट)\s*/g,'@').replace(/\s+/g,'');
    if(/^[a-z0-9._\-]{2,}@[a-z0-9]{2,}$/.test(s)){DB.settings.upi=s;save();render();return 'UPI ID सेट हो गई।'}
    return 'UPI ID बोलकर सही नहीं आती। नीचे बॉक्स में टाइप करके भेजिए, जैसे: UPI ID name@upi';
  }
  if(/https?:\/\/\S+/i.test(raw)&&has(t,'(लिंक|link|वेब)')){
    DB.settings.link=raw.match(/https?:\/\/\S+/i)[0];save();render();return 'ऐप का वेब लिंक सेट कर दिया।';
  }
  if(has(t,'(पिन|pin)')&&!named){
    if(has(t,'(हटा|बंद|खत्म|रिमूव|खाली)')){
      if(!DB.settings.pin)return 'PIN पहले से बंद है।';
      return confirmAct('ऐप का PIN लॉक बंद करना है?',()=>{DB.settings.pin='';save();render();return 'PIN लॉक बंद कर दिया।'});
    }
    const d=tk.filter(isDigTok).map(digOf).join('');
    if(d.length>=4&&d.length<=6){DB.settings.pin=d;save();sessionStorage.setItem('kb_ok','1');render();return 'PIN सेट हो गया। सुरक्षा के लिए अंक नहीं दोहरा रहा।'}
    return ask('4 से 6 अंकों का नया PIN बोलिए या नीचे टाइप कीजिए।',(r2,t2)=>{
      const dd=t2.split(' ').filter(isDigTok).map(digOf).join('');
      if(dd.length<4||dd.length>6)return 'PIN 4 से 6 अंक का होना चाहिए।';
      P=null;DB.settings.pin=dd;save();sessionStorage.setItem('kb_ok','1');render();return 'PIN सेट हो गया।';
    });
  }
  if(has(t,'(जमा|एडवांस) (लिमिट|सीमा)')||(has(t,'(डिफॉल्ट|नए खातों|नये खातों|सभी खातों|सब खातों)')&&has(t,'(लिमिट|सीमा)'))){
    const isDep=has(t,'(जमा|एडवांस) (लिमिट|सीमा)');
    const zero=has(t,'(बिना|हटा|कोई लिमिट नहीं|कोई सीमा नहीं|शून्य|जीरो|खत्म)');
    const v=zero?0:parseAmount(t);
    const apply=n=>{if(isDep)DB.settings.depositLimit=n;else DB.settings.defaultCreditLimit=n;save();render();return (isDep?'जमा लिमिट ':'डिफ़ॉल्ट उधार सीमा ')+(n>0?sp(n):'बंद')+' कर दी।'};
    if(v!==null&&v>=0)return apply(v);
    return ask((isDep?'जमा लिमिट':'डिफ़ॉल्ट उधार सीमा')+' कितनी रखनी है? शून्य बोलें तो कोई लिमिट नहीं।',(r2,t2)=>{
      const z=has(t2,'(बिना|कोई नहीं|शून्य|जीरो)')?0:parseAmount(t2);
      if(z===null)return 'रकम समझ नहीं आई, फिर बोलिए।';P=null;return apply(z);
    });
  }

  /* बैकअप / सबको याद दिलाना / अगला */
  if(has(t,'(बैकअप|backup)')&&has(t,'(डाउनलोड|बनाओ|करो|ले लो|निकालो|सेव)')){backup();return 'बैकअप फ़ाइल डाउनलोड हो रही है।'}
  if(!named&&has(t,'(सबको|सभी को|सारे ग्राहकों|सब ग्राहकों|सबके पास)')&&has(t,'(याद|रिमाइंडर|मैसेज|व्हाट्सएप|भेज)')){
    const n=DB.accounts.filter(a=>!a.deleted&&a.bal>0).length;
    if(!n)return 'किसी का बकाया नहीं है।';
    bulkRemind();return n+' ग्राहकों की सूची खुल गई। शुरू करने के लिए "शुरू करो" बोलिए, फिर "अगला"। पॉप-अप की अनुमति ज़रूरी है।';
  }
  if(window._bulkList&&$('#bulkProgress')&&has(t,'^(शुरू करो|शुरू|अगला|आगे|भेजो|अगले को भेजो)( |$)')){
    const i=window._bulkIdx||0;sendBulk(i);
    return i>=window._bulkList.length?'सभी को भेज दिया।':(i+1)+' में से '+(i+1)+', '+window._bulkList[i].name+' का संदेश खोल दिया।';
  }

  /* रिपोर्ट */
  if(!named){
    if(has(t,'(सबसे ज्यादा|सबसे बड़ा|सबसे अधिक) (उधार|बकाया)|टॉप|top')){
      const l=DB.accounts.filter(a=>!a.deleted&&a.bal>0).sort((a,b)=>b.bal-a.bal).slice(0,3);
      if(!l.length)return 'किसी का उधार बाकी नहीं है।';
      return 'सबसे ज़्यादा उधार: '+l.map(a=>a.name+' '+sp(a.bal)).join(', ')+'।';
    }
    if(has(t,'(बीत|ओवरड्यू|लेट|देर|तारीख निकल|तारीख गुजर)')&&has(t,'(खाते|खाता|ग्राहक|किसकी|कौन|किस)')){
      const l=DB.accounts.filter(a=>!a.deleted&&isOverdue(a));
      if(!l.length)return 'किसी की वापसी तारीख नहीं बीती।';
      return l.length+' खातों की वापसी तारीख बीत चुकी है: '+l.map(a=>a.name+' '+sp(a.bal)).join(', ')+'।';
    }
    if(has(t,'(कुल|सबका|सब का|सारा|टोटल|सारांश|कितने खाते|कितने ग्राहक|कितना उधार बाहर|कितना बकाया बाहर)')&&has(t,'(उधार|बकाया|बाकी|एडवांस|हिसाब|खाते|ग्राहक|सारांश|टोटल)'))return totalsText();
  }

  /* नेविगेशन */
  if(has(t,'(हटाए गए|हटाए हुए|डिलीट हुए|डिलीटेड)')&&has(t,'(खाते|खाता|अकाउंट)')){go('deleted');const n=DB.accounts.filter(a=>a.deleted).length;return 'हटाए गए खाते खुल गए। '+(n?n+' खाते हटे हुए हैं।':'कोई खाता हटा हुआ नहीं है।')}
  if(has(t,'(सेटिंग)')&&!named){go('settings');return 'सेटिंग खुल गई।'}
  const mon=parseMonth(t,tk);
  const DELP='(हटा|डिलीट|मिटा|साफ|क्लियर|clear|delete)';
  if(!named&&!has(t,DELP)&&(has(t,'(इतिहास|हिस्ट्री|हिसाब किताब|सारा हिसाब)')||mon)&&(!ctx||mon||has(t,'(टैब|सारा|सबका|सब का|पूरे)'))){
    if(has(t,'(सिर्फ उधार|केवल उधार|उधार वाली)'))V.hf='add';
    else if(has(t,'(सिर्फ जमा|केवल जमा)'))V.hf='sub';
    else if(has(t,'(सब एंट्री|सब दिखाओ|फिल्टर हटाओ|सारी एंट्री)'))V.hf='all';
    if(mon)V.hMonth=mon;
    go('history');
    return monthText(V.hMonth);
  }
  if(!named&&has(t,'^(खोजो|खोज|ढूंढो|ढूंढ|सर्च|search) ')){
    V.q=raw.trim().replace(/^\S+\s+/,'');V.open=null;V.tab='home';render();
    const n=DB.accounts.filter(a=>!a.deleted&&(a.name.toLowerCase().includes(V.q.toLowerCase())||a.mobile.includes(V.q))).length;
    return V.q+' के लिए '+n+' खाते मिले।';
  }
  if(!named&&has(t,'(खोज साफ|सर्च साफ|खोज हटा)')){V.q='';render();return 'खोज साफ़ कर दी।'}
  if(!named&&has(t,'^(होम|होम स्क्रीन|मुख्य|मेन|वापस|पीछे|खाते|सारे खाते|सब खाते|खाते खोलो|खातों की सूची|होम पर|मुख्य पेज)( |$)')){V.open=null;go('home');return 'होम पर आ गए।'}

  /* यहाँ से आगे खाता चाहिए */
  if(amb)return askPick(amb,raw);
  const a=ctx;
  const entryWord='(एंट्री|ट्रांजैक्शन|लेनदेन|लेन देन|एंट्रियां)';
  if(!a){
    if(has(t,DELP)||has(t,entryWord))return 'किस खाते की बात है? ग्राहक का नाम बोलिए।';
    if(parseAmount(t))return 'किस खाते में जोड़ना या घटाना है? खाते का नाम बोलिए।';
    return 'समझ नहीं आया। नाम के साथ बोलिए, जैसे "राहुल को 500 उधार", या "मदद" बोलिए।';
  }
  if(named&&V.open!==named.id){V.open=named.id;render()}

  /* हिस्ट्री/एंट्री हटाना */
  const histW='(हिस्ट्री|इतिहास)';
  if((has(t,histW)&&has(t,DELP))||(has(t,entryWord)&&has(t,DELP)&&has(t,'(सारी|सारा|सब|पूरी|पूरा|सभी)'))){
    const cnt=DB.log.filter(l=>l.acc===a.id&&!l.deleted).length;
    if(!cnt)return a.name+' के खाते में कोई इतिहास नहीं है।';
    return confirmAct(a.name+' की पूरी हिस्ट्री, '+cnt+' एंट्री, साफ़ करनी है? बैलेंस नहीं बदलेगा।',()=>delHistoryByVoice(a));
  }
  if(has(t,'(पिछली एंट्री|आखिरी एंट्री|आखरी एंट्री|पिछला ट्रांजैक्शन|आखिरी ट्रांजैक्शन|आखरी ट्रांजैक्शन|अंतिम एंट्री|अंतिम ट्रांजैक्शन|लास्ट एंट्री|last transaction|आखिरी लेनदेन|पिछला लेनदेन|undo|अनडू)')&&(has(t,DELP)||has(t,'(undo|अनडू)'))){
    const hs=DB.log.filter(l=>l.acc===a.id&&!l.deleted&&(l.type==='add'||l.type==='sub')).sort((x,y)=>y.t-x.t);
    if(!hs.length)return a.name+' के खाते में कोई लेन-देन नहीं है।';
    return confirmAct(a.name+' की आखिरी एंट्री, '+LBL[hs[0].type]+' '+sp(hs[0].amt)+', हटाकर बैलेंस वापस करना है?',()=>delLastTxnByVoice(a));
  }
  if(has(t,entryWord)&&has(t,DELP)){
    const hs=DB.log.filter(l=>l.acc===a.id&&!l.deleted).sort((x,y)=>y.t-x.t);
    if(!hs.length)return a.name+' के खाते में कोई इतिहास नहीं है।';
    let idx=null;
    for(const w of tk){if(ORDM[w]!==undefined){idx=ORDM[w];break}}
    const doIt=i=>{
      const l=hs[i];if(!l)return 'इतनी एंट्री नहीं हैं। कुल '+hs.length+' हैं।';
      return confirmAct((i+1)+' नंबर की एंट्री, '+LBL[l.type]+(l.amt?' '+sp(l.amt):'')+', इतिहास से हटानी है? बैलेंस नहीं बदलेगा।',()=>delEntryByVoice(a,l));
    };
    if(idx!==null)return doIt(idx);
    return ask('कौन सी एंट्री हटानी है? सबसे नई एंट्री पहली है। पहली, दूसरी या तीसरी बोलिए।',(r2,t2)=>{
      let j=null;for(const w of t2.split(' ')){if(ORDM[w]!==undefined){j=ORDM[w];break}}
      if(j===null)return 'पहली, दूसरी, तीसरी जैसा बोलिए।';
      P=null;return doIt(j);
    });
  }

  /* खाता हटाना */
  if(has(t,'(खाता|अकाउंट|खाते)')&&has(t,'(हटा|डिलीट|मिटा)'))
    return confirmAct(a.name+' का खाता हटाना है? वह हटाए गए में चला जाएगा।',()=>{delAcc(a.id);return a.name+' का खाता हटा दिया। वापस लाने के लिए बोलिए: '+a.name+' का खाता वापस लाओ।'});

  /* नाम / नंबर / लिमिट बदलना */
  if(has(t,'नाम')&&has(t,'(बदल|सही|चेंज|रख|अपडेट|एडिट)')){
    const nm=afterKey(raw,/नाम/);
    if(nm)return renameAcc(a,nm);
    return ask('नया नाम बोलिए।',(r2)=>{P=null;return renameAcc(a,r2)});
  }
  if(has(t,'(नंबर|मोबाइल)')&&has(t,'(बदल|सही|चेंज|अपडेट|नया)')){
    const n=phoneOnly(t);
    if(n)return changeMobile(a,n);
    return ask('नया 10 अंकों का मोबाइल नंबर बोलिए।',(r2,t2)=>{const n2=phoneOnly(t2);if(!n2)return 'नंबर 10 अंक का होना चाहिए। फिर बोलिए।';P=null;return changeMobile(a,n2)});
  }
  if(has(t,'(लिमिट|सीमा)')){
    if(has(t,'(हटा|बिना|खत्म|कोई लिमिट नहीं|कोई सीमा नहीं|शून्य|जीरो)'))return setAccLimit(a,0);
    const v=parseAmount(t);
    if(v>0)return setAccLimit(a,v);
    return ask(a.name+' की उधार सीमा कितनी करनी है?',(r2,t2)=>{const z=parseAmount(t2);if(!(z>0))return 'रकम समझ नहीं आई, फिर बोलिए।';P=null;return setAccLimit(a,z)});
  }

  /* जानकारी पूछना */
  if(has(t,'(क्या सामान|कौन सा सामान|सामान क्या|सामान बताओ|क्या क्या दिया)')){
    const l=DB.log.filter(x=>x.acc===a.id&&!x.deleted&&x.type==='add'&&x.items).sort((x,y)=>y.t-x.t).slice(0,3);
    if(!l.length)return a.name+' को दिए सामान की कोई जानकारी नहीं है।';
    return a.name+' को दिया सामान: '+l.map(x=>x.items+' ('+dt(x.t).split(',')[0]+')').join('; ')+'।';
  }
  if(has(t,'(वापसी तारीख|कब देगा|कब देगी|कब तक देना|कब वापस)')&&!parseAmount(t)){
    const d=nextDue(a);
    if(!d||a.bal<=0)return a.name+' की कोई वापसी तारीख तय नहीं है।';
    return a.name+' की वापसी तारीख '+dt(d).split(',')[0]+(d<Date.now()?', जो बीत चुकी है':'')+' है।';
  }
  if(has(t,'(कितने पैसे|पैसे कितने|बैलेंस|हिसाब कितना|रुपए कितने|रुपये कितने|कितना बकाया|कितना बाकी|बाकी कितना|कितना उधार|उधार कितना|कितना देना|कितना जमा|एडवांस कितना|कितना है)'))
    return a.name+' के खाते में '+balText(a)+'।';
  if(has(t,'(हिस्ट्री|इतिहास|एंट्री|ट्रांजैक्शन|लेनदेन|लेन देन)')){
    let n=parseAmount(t);n=n&&n>0&&n<=10?Math.round(n):3;
    const hs=DB.log.filter(l=>l.acc===a.id&&!l.deleted).sort((x,y)=>y.t-x.t);
    if(!hs.length)return a.name+' के खाते में अभी कोई इतिहास नहीं है।';
    return a.name+' की आखिरी '+Math.min(n,hs.length)+' एंट्री: '+hs.slice(0,n).map(l=>LBL[l.type]+(l.amt?' '+sp(l.amt):'')+(l.items?', सामान '+l.items:'')+(l.due&&l.type==='add'?', वापसी '+dt(l.due).split(',')[0]:'')).join('। ')+'।';
  }

  /* क्रियाएँ */
  if(has(t,'(स्टेटमेंट|पीडीएफ|pdf|प्रिंट)')){printStatement(a.id);return a.name+' का स्टेटमेंट खोल रहा हूँ। पॉप-अप की अनुमति दें।'}
  if(has(t,'(क्यूआर|qr|कोड स्कैन)')){
    const up=has(t,'(यूपीआई|upi|पेमेंट)');
    if(up&&!upiLink(a))return up&&!DB.settings.upi?'UPI QR के लिए पहले UPI ID सेट कीजिए।':'इस खाते में बकाया नहीं है, UPI QR नहीं बनेगा।';
    showQR(a.id,up?'upi':'chk');return a.name+' का क्यूआर कोड खोल दिया।';
  }
  if(has(t,'(व्हाट्सएप|whatsapp|मैसेज भेज|मैसेज करो|रिमाइंडर|याद दिला|भेजो|भेज दो|संदेश)')){
    shareWA(a.id);return a.name+' के व्हाट्सएप पर संदेश खोल दिया।';
  }

  /* पैसे जोड़ना/घटाना */
  const amtCheck=extractTxn(t).amt;
  if(amtCheck>0)return doTxnVoice(a,t);

  return a.name+' का खाता खुल गया है। इस समय '+balText(a)+'।';
}

function newAccFlow(pre){
  const d={name:pre.name||'',mobile:pre.mobile||'',limit:null,quick:!!(pre.name&&pre.mobile)};
  const step=()=>{
    if(!d.name)return ask('नया खाता बनाने के लिए ग्राहक का नाम बताइए।',(raw)=>{d.name=raw.trim();return step()});
    if(!d.mobile)return ask(d.name+' का 10 अंकों का मोबाइल नंबर बोलिए।',(raw,t)=>{
      const m=phoneOnly(t);
      if(!m)return 'मोबाइल नंबर 10 अंक का होना चाहिए। कृपया सही नंबर बोलिए।';
      if(DB.accounts.some(a=>!a.deleted&&h10(a.mobile)===m))return 'इस नंबर का खाता पहले से है। कोई दूसरा नंबर बोलिए।';
      d.mobile=m;return step();
    });
    if(d.limit===null){
      if(d.quick){d.limit=DB.settings.defaultCreditLimit||0}
      else return ask('इस खाते की उधार सीमा कितनी रखनी है? रुपये बोलें, या शून्य बोलें।',(raw,t)=>{
        if(has(t,'(डिफॉल्ट|सामान्य|वही)'))d.limit=DB.settings.defaultCreditLimit||0;
        else{const v=parseAmount(t);d.limit=v>0?v:0}
        return step();
      });
    }
    P=null;
    const res=createAccount(d.name,d.mobile,'आवाज़',d.limit);
    if(typeof res==='string'){d.mobile='';return res+' '+step()}
    V.open=res.id;render();
    return d.name+' का नया खाता बन गया और खुल गया।'+(d.limit>0?' उधार सीमा '+sp(d.limit)+'।':'');
  };
  return step();
}

/* ================== आवाज़ पैनल और माइक ================== */
let rec=null,voiceActive=false,voiceOpen=false,micDenied=false;
function getHindiVoice(){
  try{const vs=speechSynthesis.getVoices();return vs.find(v=>v.lang==='hi-IN')||vs.find(v=>v.lang&&v.lang.startsWith('hi'))||null}catch(e){return null}
}
function speak(m,onend){
  let fired=false,tm=0;
  const fin=()=>{if(fired)return;fired=true;clearTimeout(tm);if(onend)onend()};
  tm=setTimeout(fin,Math.min(20000,3000+String(m).length*130)); // कुछ फ़ोन में बोलना खत्म होने का संकेत नहीं आता, तब भी सुनना दोबारा शुरू हो
  try{
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(String(m).replace(/₹/g,' रुपये '));
    u.lang='hi-IN';
    const v=getHindiVoice();if(v)u.voice=v;
    u.rate=1;u.pitch=1;
    u.onend=fin;u.onerror=fin;
    speechSynthesis.speak(u);
  }catch(e){fin()}
}
const HELP_HTML='<div class="hint" style="line-height:1.8">'
+'<b>खाते</b><br>• नया खाता / नया खाता राहुल 9876543210<br>• राहुल का खाता खोलो · राहुल का बैलेंस बताओ<br>• राहुल का नाम बदलकर रवि करो · राहुल का नंबर बदलो<br>• राहुल की लिमिट 5000 करो · राहुल की लिमिट हटाओ<br>• राहुल का खाता हटाओ · राहुल का खाता वापस लाओ · राहुल का खाता हमेशा के लिए हटाओ<br>'
+'<b>उधार / जमा</b><br>• राहुल को 500 उधार<br>• राहुल को 2 किलो चीनी 1 लीटर तेल 400 रुपये उधार वापसी 5 दिन में<br>• राहुल के 200 जमा / राहुल को माइनस 200<br>• (खाता खुला हो तो) प्लस 500 / माइनस 200<br>'
+'<b>इतिहास</b><br>• राहुल की हिस्ट्री दिखाओ / आखिरी 5 एंट्री बताओ<br>• राहुल की हिस्ट्री डिलीट करो (बैलेंस नहीं बदलता)<br>• राहुल की आखिरी एंट्री हटाओ (बैलेंस वापस होता है)<br>• राहुल की दूसरी एंट्री हटाओ · राहुल को क्या सामान दिया · राहुल की वापसी तारीख<br>'
+'<b>स्टॉक</b><br>• चीनी और तेल खत्म · स्टॉक में आटा जोड़ो<br>• चीनी आ गया · स्टॉक बताओ · स्टॉक व्हाट्सएप पर भेजो · सारा स्टॉक हटाओ<br>'
+'<b>रिपोर्ट / टैब</b><br>• कुल उधार कितना है · सबसे ज़्यादा उधार किसका · किसकी तारीख बीत गई<br>• इतिहास खोलो · पिछले महीने का इतिहास · अक्टूबर का इतिहास · सिर्फ उधार दिखाओ<br>• स्टॉक खोलो · हटाए गए खाते · सेटिंग खोलो · होम / वापस · खोजो राहुल<br>'
+'<b>सेटिंग</b><br>• दुकान का नाम गुप्ता स्टोर रखो · जमा लिमिट 2000 करो · डिफ़ॉल्ट उधार सीमा 5000 करो<br>• पिन सेट करो 1234 · पिन हटाओ · UPI ID और ऐप लिंक नीचे टाइप करके दें<br>'
+'<b>और काम</b><br>• राहुल को व्हाट्सएप भेजो · राहुल का क्यूआर · राहुल का यूपीआई क्यूआर · राहुल का स्टेटमेंट<br>• सबको याद दिलाओ → शुरू करो → अगला · बैकअप डाउनलोड करो<br>• हटाने जैसे काम से पहले मैं पूछूँगा — "हाँ" या "नहीं" बोलिए · रद्द करो · बंद करो</div>';
function openVoice(){
  if(!voiceOpen){
    voiceOpen=true;micDenied=false;
    const p=$('#vpanel');
    p.innerHTML='<div class="vh"><b>🎤 आवाज़ सहायक</b><span id="vstat" class="mut" style="font-size:13px;flex:1;text-align:right">तैयार</span><button class="btn2 d" onclick="closeVoice()">✕</button></div>'
     +'<div id="vtr" class="tr"></div><div id="vres" class="res"></div>'
     +'<div class="row"><input id="vtxt" placeholder="यहाँ टाइप करके भी कमांड दें" onkeydown="if(event.key===\'Enter\')vText()"><button class="btn" onclick="vText()">भेजें</button></div>'
     +'<div class="row"><button class="btn2" onclick="listen()">🎤 सुनो</button><button class="btn2" onclick="pauseVoice()">⏸ रोको</button></div>'
     +'<details style="margin-top:8px"><summary class="hint" style="cursor:pointer">💡 क्या-क्या बोल सकते हैं?</summary>'+HELP_HTML+'</details>';
    p.classList.add('on');document.body.classList.add('vp');
  }
  voiceActive=true;P=null;micDenied=false;
  startRec(); // सीधे बटन दबाने के साथ ही माइक शुरू (कई फ़ोन में यही ज़रूरी है)
}
function closeVoice(){
  voiceActive=false;voiceOpen=false;P=null;closeLater=false;
  try{rec&&rec.abort()}catch(e){}rec=null;
  try{speechSynthesis.cancel()}catch(e){}
  const p=$('#vpanel');p.classList.remove('on');p.innerHTML='';document.body.classList.remove('vp');
  const mb=$('#micBtn');if(mb)mb.classList.remove('rec');
}
function pauseVoice(){voiceActive=false;try{rec&&rec.abort()}catch(e){}try{speechSynthesis.cancel()}catch(e){}const s=$('#vstat');if(s)s.textContent='रुका हुआ — 🎤 दबाइए'}
function listen(){voiceActive=true;micDenied=false;startRec()}
function vShow(t,r){const a=$('#vtr'),b=$('#vres');if(a&&t!=null)a.textContent='आपने कहा: "'+t+'"';if(b&&r!=null)b.textContent=r}
function vRun(text){
  let r;
  try{r=runCommand(text)}catch(e){console.error(e);P=null;r='कुछ गड़बड़ हो गई, फिर से बोलिए।'}
  vShow(text,r);
  const s=$('#vstat');if(s)s.textContent='काम हो गया। आगे बोलिए...';
  const done=()=>{
    if(closeLater){closeLater=false;closeVoice();return}
    if(voiceActive)setTimeout(()=>{if(voiceActive)startRec()},500);
  };
  if(r)speak(r,done);else done();
}
function vText(){const i=$('#vtxt');if(!i||!i.value.trim())return;const t=i.value;i.value='';try{rec&&rec.abort()}catch(e){}vRun(t)}
function startRec(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  const st=$('#vstat');
  if(!SR){if(st)st.textContent='❌ इस ब्राउज़र/ऐप में माइक की सुविधा नहीं है। Chrome में खोलिए, या नीचे टाइप कीजिए';return}
  if(!window.isSecureContext&&location.protocol!=='file:'){if(st)st.textContent='❌ माइक के लिए https:// वाला लिंक चाहिए';return}
  try{rec&&rec.abort()}catch(e){}
  try{speechSynthesis.cancel()}catch(e){}
  rec=new SR();rec.lang='hi-IN';rec.interimResults=true;rec.continuous=false;
  let last='';
  rec.onstart=()=>{const s=$('#vstat');if(s&&voiceActive)s.textContent='🔴 सुन रहा हूँ... बोलिए';const mb=$('#micBtn');if(mb)mb.classList.add('rec')};
  rec.onresult=e=>{let s='';for(const r of e.results)s+=r[0].transcript;last=s;vShow(s,null)};
  rec.onerror=e=>{
    const mb=$('#micBtn');if(mb)mb.classList.remove('rec');
    const s=$('#vstat');
    if(e.error==='not-allowed'||e.error==='service-not-allowed'){micDenied=true;voiceActive=false;if(s)s.textContent='❌ माइक की अनुमति बंद है — ब्राउज़र की साइट सेटिंग में माइक "अनुमति दें" कीजिए (या https:// लिंक से खोलिए)'}
    else if(e.error==='audio-capture'){micDenied=true;voiceActive=false;if(s)s.textContent='❌ माइक नहीं मिला / कोई दूसरा ऐप माइक इस्तेमाल कर रहा है'}
    else if(e.error==='network'){micDenied=true;voiceActive=false;if(s)s.textContent='❌ आवाज़ पहचान के लिए इंटरनेट चाहिए'}
    else if(e.error==='language-not-supported'){micDenied=true;voiceActive=false;if(s)s.textContent='❌ इस फ़ोन में हिंदी आवाज़ पहचान चालू नहीं'}
  };
  rec.onend=()=>{
    const mb=$('#micBtn');if(mb)mb.classList.remove('rec');
    if(micDenied)return;
    if(last&&voiceActive){vRun(last)}
    else if(voiceActive){setTimeout(()=>{if(voiceActive)startRec()},800)}
  };
  try{rec.start()}catch(e){}
}

if(!(location.hash.startsWith('#c=')&&customerView()))render();
