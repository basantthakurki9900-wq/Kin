function restore(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.accounts||!Array.isArray(d.accounts))throw 0;if(!d.settings||typeof d.settings!=='object')d.settings={};if(!Array.isArray(d.log))d.log=[];if(!Array.isArray(d.stock))d.stock=[];DB=d;if(!DB.settings.shop)DB.settings.shop='मेरी दुकान';if(DB.settings.upi===undefined)DB.settings.upi='';if(DB.settings.link===undefined)DB.settings.link='';if(DB.settings.pin===undefined)DB.settings.pin='';if(!DB.settings.depositLimit)DB.settings.depositLimit=1000;if(DB.settings.defaultCreditLimit===undefined)DB.settings.defaultCreditLimit=0;DB.log.forEach(l=>{if(l.deleted===undefined)l.deleted=false});DB.accounts.forEach(a=>{if(a.limit===undefined)a.limit=0;if(a.deleted===undefined)a.deleted=false});save();render();toast('बैकअप वापस आ गया')}catch(e){toast('गलत फ़ाइल')}};r.readAsText(f)}

